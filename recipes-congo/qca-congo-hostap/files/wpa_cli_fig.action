#!/bin/sh
FLAG=/tmp/wpa_disconnected_wlan0
IFACE=wlan0
PIDFILE=/var/run/udhcpc.wlan0.pid

do_dhcp_renew() {
    kill -USR1 $(cat "$PIDFILE" 2>/dev/null) 2>/dev/null
}

gateway_reachable() {
    local gw
    gw=$(ip route show dev "$IFACE" | awk '/default/ {print $3; exit}')
    [ -z "$gw" ] && return 1
    arping -f -c 2 -w 2 -I "$IFACE" "$gw" >/dev/null 2>&1
}

case "$2" in
    DISCONNECTED)
        # Mark that a real disconnect happened.
        # Covers: normal reconnect, rmmod/modprobe, FW SSR, link-down/up.
        touch "$FLAG"
        ;;
    CONNECTED)
        if [ -f "$FLAG" ]; then
            # Came through DISCONNECTED: IP is invalid, always renew.
            rm -f "$FLAG"
            do_dhcp_renew
        else
            # Roaming path (no DISCONNECTED): only renew if subnet changed.
            # Gateway unreachable means we're on a different broadcast domain.
            gateway_reachable || do_dhcp_renew
        fi
        ;;
esac
