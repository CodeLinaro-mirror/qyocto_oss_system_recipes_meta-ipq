/dts-v1/;

/ {
	description = DESCRIPTION;
	#address-cells = <1>;

	images {
		kernel-1 {
			description = "ARM Yocto Linux-LINUX_VERSION";
			data = /incbin/("./Image.lzma");
			type = "kernel";
			arch = "ARCH";
			os = "linux";
			compression = "lzma";
			load = <LOAD>;
			entry = <ENTRY>;
			hash-1 {
				algo = "crc32";
			};
			hash-2 {
				algo = "sha1";
			};
		};

