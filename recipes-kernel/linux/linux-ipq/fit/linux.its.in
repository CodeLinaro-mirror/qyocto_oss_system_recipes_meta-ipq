/dts-v1/;

/ {
	description = DESCRIPTION;
	#address-cells = <1>;

	images {
		kernel-1 {
			description = "ARM Yocto Linux-LINUX_VERSION";
			data = /incbin/("./Image.lzma");
			type = "kernel";
			arch = "ARCH";
			os = "linux";
			compression = "lzma";
			load = <LOAD>;
			entry = <ENTRY>;
			hash-1 {
				algo = "crc32";
			};
			hash-2 {
				algo = "sha1";
			};
		};

		fdt-1 {
			description = "DTB_NAME device tree blob";
			data = /incbin/("./linux.dtb");
			type = "flat_dt";
			arch = "ARCH";
			compression = "none";
			hash-1 {
				algo = "crc32";
			};
			hash-2 {
				algo = "sha1";
			};
		};
	};

	configurations {
		default = "config-1";
		config-1 {
			description = DESCRIPTION;
			kernel = "kernel-1";
			fdt = "fdt-1";
		};
	};
};
